{
  "name": "djmond",
  "version": "1.5.0",
  "description": "DiamondJdev's opinionated CLI wrapper",
  "type": "module",
  "bin": {
    "dj": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist",
    "ascii.txt",
    "skills"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "npm"
  ],
  "author": "DiamondJdev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiamondJdev/djCLI.git"
  },
  "homepage": "https://github.com/DiamondJdev/djCLI#readme",
  "bugs": {
    "url": "https://github.com/DiamondJdev/djCLI/issues"
  }
}
